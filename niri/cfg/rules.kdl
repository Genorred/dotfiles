
    window-rule {
        // geometry-corner-radius 20 // Set every window radius to 20
        clip-to-geometry true
        tiled-state true
        // open-maximized true
    }
    window-rule {
        // Targets only windows that are in the floating layout
        match is-floating=true
        
        // Sets the window transparency (e.g., 85% opaque)
        // opacity 0.85
    }

    window-rule {
        match app-id="deskflow"
        match title="Deskflow"
        
        // Forces the window to stay maximized or fullscreened to grab the cursor properly
        open-maximized true
        // exclude-from-states true
    }
    window-rule {
        match app-id="asciiquarium-fullscreen"
        open-maximized true
    }

    layer-rule {
        match namespace="^noctalia-wallpaper*"
        place-within-backdrop true
    }
